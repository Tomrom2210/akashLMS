          {{/ output.loggedinuser }}
        </div>
      </div>
    

    <!-- Right Side -->
    <div class="footer-right">
      <div class="footer-down">
          <img src="https://elearnkranti.com/pluginfile.php/1/core_admin/logocompact/300x300/1767950654/eLearnKranti%20Logo%20%281%29.png" class="logo me-1" alt="Pariksha Kranti" style="margin-bottom: 20px !important;">
