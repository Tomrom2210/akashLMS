{{#js}}
if (document.querySelector('[data-action="footer-popover"]') &&
        document.querySelector('[data-region="footer-container-popover"]') &&
        document.querySelector('[data-region="footer-content-popover"]')) {
    require(['theme_boost/footer-popover'], function(FooterPopover) {
        FooterPopover.init();
    });
}

(function() {
    const categoryList = document.getElementById('footer-category-list');
    if (!categoryList) {
        return;
    }

    fetch('{{ config.wwwroot }}/theme/boost/footer_categories.php', {credentials: 'same-origin'})
        .then(response => response.json())
        .then(data => {
            const categories = Array.isArray(data.categories) ? data.categories : [];
            categoryList.innerHTML = '';

            categories.forEach(category => {
                const item = document.createElement('li');
                const anchor = document.createElement('a');
                anchor.href = category.url;
                anchor.textContent = category.name;
                item.appendChild(anchor);
                categoryList.appendChild(item);
            });

            if (!categories.length) {
                categoryList.innerHTML = '<li><a href="{{ config.wwwroot }}/course/index.php">Browse all categories</a></li>';
            }
        })
        .catch(() => {
            categoryList.innerHTML = '<li><a href="{{ config.wwwroot }}/course/index.php">Browse all categories</a></li>';
        });
})();
{{/js}}










