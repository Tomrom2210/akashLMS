<style>
    .logotop{
        max-height:calc(90px - (0.25rem * 2)) !important;
    }
    .MenuSection{
        display: flex;
    }
    .navbar {
        height: 90px !important;
    }
    .navbar>.container-fluid{
            padding: 10px 35px;
    }
    
.SearchSection{
            min-width: 40%;
            display: flex;
            align-items: center;
            gap: 8px;
    }

    .search-toggle{
        color: inherit;
        text-decoration: none;
        padding: 4px 6px;
    }
    .search-form-wrap{
        display: none;
        flex: 1;
    }
    .SearchSection.is-open .search-form-wrap{
        display: block;
    }
    
    
    .SearchSection input{
            min-width: 80%;
            border: none;
    }
    
    .SearchSection form{
        border: 1px solid #dddddd;
    padding: 4px 4px;
    border-radius: 35px;
    }
    
    .SearchSection button{
        width: 18%;
    border-radius: 40px;
    background-image: linear-gradient(275deg, #4b5aed, #a865e9);
    color: white;
    border: none;
    }
    
    .navbar.fixed-top {
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    box-shadow: 0px 10px 10px -12px black !important;
}

.moremenu .nav-link.active {
    border-bottom-color: white !important;
}
.navbar.fixed-top .nav-link {
    font-weight: 600;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.request-callback-btn {
    border-radius: 999px;
    padding: 6px 16px;
    font-weight: 600;
    border-radius: 40px;
    background-image: linear-gradient(275deg, #4b5aed, #a865e9);
    color: white;
    border: none;
}

.login-icon-link i,
#quickMenu i {
    font-size: 18px;
}

@media (min-width: 768px) {
  .nav-item.dropdown:hover > .dropdown-menu {
    display: block;
  }
}

.navbar .dropdown-menu {
    max-width: 360px;
    min-width: 240px;
    max-height: 60vh;
    overflow-y: auto;
}

.navbar .dropdown-item,
.navbar .dropdown-item-text {
    white-space: normal;
    line-height: 1.35;
    word-break: break-word;
}

/* Keep hamburger dropdown inside viewport */
#quickMenu + .dropdown-menu {
    right: 0;
    left: auto;
}

@media only screen and (max-width: 900px) {
  .SearchSection input {
        min-width: 65% !important;
        max-width: 65% !important;
    }
    .SearchSection button{
        width: 30%;
    }
}

@media (min-width: 992px) {
    .search-form-wrap{
        display: block;
    }
    .search-toggle{
        display: none;
    }
}
    
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-search="wrapper"]').forEach(function (wrap) {
      var toggle = wrap.querySelector('[data-search="toggle"]');
      var formWrap = wrap.querySelector('[data-search="form"]');
      if (!toggle || !formWrap) { return; }
      toggle.addEventListener('click', function () {
        wrap.classList.toggle('is-open');
        if (wrap.classList.contains('is-open')) {
          var input = formWrap.querySelector('input');
          if (input) { input.focus(); }
        }
      });
    });
  });
</script>

