.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 fixed columns on large screens */
  gap: 20px;
  margin: 0 auto;
  border-radius: 12px;
}

.feature-card {
  padding: 16px;
  border: 2px solid #ccc;
  border-radius: 12px;
  background: #fff;
  transition: transform 0.2s ease;
}

.feature-card h3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  font-size: 1.05rem;
}

/* Match text color to border color */
.feature-card.red h3 { color: #ff4d4f; }
.feature-card.blue h3 { color: #4f75ff; }
.feature-card.pink h3 { color: #e89dd0; }
.feature-card.yellow h3 { color: #f8c954; }
.feature-card.green h3 { color: #5dd381; }
.feature-card.rose h3 { color: #e47285; }
.feature-card.teal h3 { color: #9fdfe0; }
.feature-card.indigo h3 { color: #9a9fff; }


/* Colored borders */
.feature-card.red { border-color: #ff4d4f; }
.feature-card.blue { border-color: #4f75ff; }
.feature-card.pink { border-color: #e89dd0; }
.feature-card.yellow { border-color: #f8c954; }
.feature-card.green { border-color: #5dd381; }
.feature-card.rose { border-color: #e47285; }
.feature-card.teal { border-color: #9fdfe0; }
.feature-card.indigo { border-color: #9a9fff; }

.feature-card p {
  font-size: 14px;
  line-height: 1.4;
  color: #333;
}

.feature-card:hover {
  transform: translateY(-5px);
}

/* Medium Screens - show 2 per row */
@media (max-width: 1024px) {
  .features {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Small Screens - stack in 1 column */
@media (max-width: 600px) {
  .features {
    grid-template-columns: 1fr;
    padding: 15px;
    gap: 15px;
  }

  .feature-card {
    padding: 12px;
  }

  .feature-card h3 {
    font-size: 0.95rem;
  }

  .feature-card p {
    font-size: 12.5px;
  }
}





