  font-size: 2rem;
  margin-bottom: 5px;
}

.subtitle {
  color: #555;
  font-size: 0.95rem;
  margin-bottom: 20px;
}

/* Tabs */
.tabs {
  list-style: none;
  padding: 0;
  margin: 0 auto 25px;
  display: flex;
  justify-content: center;
  gap: 30px;
  border-bottom: 2px solid #ddd;
  flex-wrap: wrap;
  max-width: 100%;
}

.tabs li {
  cursor: pointer;
  padding-bottom: 10px;
  font-weight: 500;
  position: relative;
}

.tabs li.active {
  color: black;
  border-bottom: 2px solid black;
}

/* Courses Grid */
.courses-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 cards per row on large screen */
  gap: 20px;
  justify-items: center;
}

.card {
  background-color: #fff;
  border: 2px solid #ddd;
  border-radius: 10px;
  padding: 15px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 250px;
}

.card img {
  object-fit: contain;
  margin-bottom: 10px;
}

.card h3 {
  font-size: 1.1rem;
  margin-bottom: 5px;
}

.card p {
  font-size: 0.9rem;
  color: #444;
  margin-bottom: 10px;
}

.rating-price {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 10px;
  font-size: 0.9rem;
}

.tag{
  padding-right:65px;
  
}
.rating-price .price {
  color: #000;
}

.rating-price del {
  color: #999;
  font-size: 0.8rem;
  margin-left: 2px;
}

.starss {
  color: #ffaa00;
}

/* Badges */
.badges {
  display: inline-block;
  background-color: #014443;
  color: white;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.8rem;
  margin-top: 5px;
  width:40%;
  margin-left:30%;
}

/* Responsive Styles */

/* Tablets (2 cards per row) */
@media (max-width: 992px) {
  .courses-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .explore-courses {
    padding: 30px 15px;
  }

  .card {
    max-width: 100%;
  }
