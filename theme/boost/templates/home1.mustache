/* Container for the course card image */
/* Image wrapper with fixed dimensions */
.course-image-wrapper {
  width: 100%;
  height: 160px;
  overflow: hidden;
  display: flex;
  justify-content: center;
  margin-bottom: 10px;
  border-radius: 8px;
}

/* Force image to fully cover wrapper */
.course-image-wrapper img {
        margin: 0px !important;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 8px;
}

/* Course title styling */
.coursebox .coursename a {
    font-family: 'Montserrat';
    line-height: 30px;
    font-size: 20px;
    color: #000;
    font-weight: 700;
    display: block;
    margin-bottom: 10px;
    text-decoration: none;
}

.course-summary{
   font-size: 12px;
 
  line-height: 1.5em;
  max-height: 3em;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 5px;
}

/* Course summary clamped to 2 lines */
.course-summary p{
  font-size: 12px;
 
  line-height: 1.5em;
  max-height: 3em;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 5px;
  
}





/* Course footer (teacher + button) aligned in row */
.course-footer {
  display: flex;
  justify-content: space-between;
