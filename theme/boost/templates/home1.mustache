/* General Course Box Styling */
#region-main-box .coursebox {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 30px;
    background-color: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

/* Banner Image on Top */
#region-main-box .coursebox::before {
    content: '';
    display: block;
    height: 150px;
    background: url('https://edly-moodle.hibootstrap.com/theme/edly/pix/page-banner/ellipse.png') center/cover no-repeat;
    border-radius: 10px 10px 0 0;
    margin-bottom: 15px;
}

/* Course Image Styling */
#region-main-box .course-image-wrapper,
#region-main-box .courseimage {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 10px auto;
    max-width: 300px;
    height: auto;
}

#region-main-box .courseimage {
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: contain;
}

/* Course Title */
#region-main-box .coursename a {
    font-size: 14px;
    color: #000;
    font-weight: 600;
    
    display: block;
    margin-bottom: 10px;
    text-decoration: none;
}

/* Course Summary */
#region-main-box .course-summary p {
    font-size: 16px;
    color: #333;
    line-height: 1.6;
    margin-bottom: 15px;
}

/* Teacher Info */
#region-main-box .teachers {
    font-size: 16px;
    color: #555;
    margin-bottom: 15px;
}

#region-main-box .teachers a {
    color: #015c5c;
