/* Main Section */
.courses-section {
  position: relative;
  max-width: 1240px;
  margin: 70px auto;
  padding: 70px 28px;
  border-radius: 28px;
  background:
    radial-gradient(900px 260px at 12% -10%, rgba(99, 102, 241, 0.24), transparent 60%),
    radial-gradient(900px 320px at 110% 0%, rgba(14, 165, 233, 0.22), transparent 55%),
    linear-gradient(135deg, #f8fafc 0%, #eef2ff 55%, #f0f9ff 100%);
  box-shadow: 0 30px 70px rgba(15, 23, 42, 0.14);
  overflow: hidden;
  animation: courses-fade 0.8s ease both;
}

.courses-section::before {
  content: "";
  position: absolute;
  inset: -40% -20% auto auto;
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.28), transparent 70%);
  filter: blur(12px);
}

.courses-section::after {
  content: "";
  position: absolute;
  inset: auto auto -50% -15%;
  width: 520px;
  height: 520px;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.25), transparent 70%);
  filter: blur(14px);
}

.courses-header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 28px;
}

.courses-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: #0f172a;
  font-weight: 700;
  background: #fff;
  padding: 6px 12px;
  border-radius: 999px;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
}

.courses-section h1 {
  font-size: 34px;
  margin: 10px 0 6px;
  color: #0f172a;
}

.courses-section .subtitle {
  color: #475467;
  font-size: 15px;
  margin: 0;
}

.courses-actions {
  display: flex;
  justify-content: flex-end;
}

.courses-cta {
  border: none;
  border-radius: 14px;
  padding: 12px 18px;
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #111827, #4f46e5);
  box-shadow: 0 12px 28px rgba(79, 70, 229, 0.24);
  cursor: pointer;
}

.courses-tabs {
  position: relative;
  z-index: 1;
}

/* Tabs */
.tabs {
  list-style: none;
  padding: 14px 16px;
  margin: 0 0 32px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow:
    0 18px 36px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  position: relative;
  overflow: hidden;
  animation: tabs-slide 0.6s ease 0.1s both;
}

.tab-button {
  padding: 10px 16px;
  border-radius: 14px;
  cursor: pointer;
  font-weight: 600;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow:
    0 10px 22px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.tab-button:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 16px 28px rgba(15, 23, 42, 0.16);
}

.tab-button.active {
  color: #0f172a;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 18px 30px rgba(15, 23, 42, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.tab-button::after {
  content: "";
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: -5px;
  height: 2px;
  border-radius: 999px;
  background: transparent;
  transition: background 0.2s ease, opacity 0.2s ease;
}

.tabs::before {
  content: "";
  position: absolute;
  inset: -40% -20% auto auto;
  width: 240px;
  height: 240px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.25), transparent 65%);
  filter: blur(6px);
  animation: glow-float 8s ease-in-out infinite;
}

@keyframes courses-fade {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tabs-slide {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tab-sheen {
  0% { transform: translateX(-120%); opacity: 0; }
  35% { opacity: 1; }
  70% { transform: translateX(180%); opacity: 0; }
  100% { transform: translateX(180%); opacity: 0; }
}

@keyframes tab-border {
  0% { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}

@keyframes underline-sweep {
  0% { transform: translateX(-30%); opacity: 0.4; }
  50% { transform: translateX(0); opacity: 1; }
  100% { transform: translateX(30%); opacity: 0.4; }
}

@media (prefers-reduced-motion: reduce) {
  .courses-section,
  .tabs,
  .tab-button {
    animation: none !important;
    transition: none !important;
  }
}

/* Tab Content */
.tab-content {
  display: none;
  padding: 0;
}

.tab-content.active {
  display: block;
}

/* Courses Grid */
.course-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.course-card {
  background: #fff;
  border-radius: 18px;
