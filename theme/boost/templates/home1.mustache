.top-educators-section {
  position: relative;
  margin: 70px auto;
  padding: 70px 24px;
  max-width: 1200px;
  background: linear-gradient(120deg, #0f172a 0%, #1e1b4b 45%, #111827 100%);
  border-radius: 26px;
  color: #f8fafc;
  overflow: hidden;
  text-align: left;
}

.top-educators-section::before {
  content: "";
  position: absolute;
  inset: -40% -20% auto auto;
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.45), transparent 65%);
  filter: blur(8px);
}

.top-educators-section::after {
  content: "";
  position: absolute;
  inset: auto auto -50% -15%;
  width: 480px;
  height: 480px;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.4), transparent 70%);
  filter: blur(12px);
}

.top-educators-section h2 {
  position: relative;
  z-index: 1;
  font-size: 30px;
  margin: 0 0 8px;
  color: #f8fafc;
}

.top-educators-section .subtitle {
  position: relative;
  z-index: 1;
  color: #cbd5f5;
  margin-bottom: 28px;
}

.educators-container {
  position: relative;
  z-index: 1;
  display: grid;
