    padding: 10px 20px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-block;
    font-weight: 500;
    transition: background-color 0.3s ease;
}

#region-main-box .buynow a.btn-primary:hover {
    background-color: #015c5c;
}


