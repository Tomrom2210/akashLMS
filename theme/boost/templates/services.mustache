<section class="tp-services-page">
  <div class="tp-services-hero">
    <div class="tp-services-shell">
      <div class="tp-services-hero__content">
        <span class="tp-services-pill">{{eyebrow}}</span>
        <h1>{{heroheading}}</h1>
        <p class="tp-services-lead">{{herocopy}}</p>
        <div class="tp-services-hero__actions">
          <a href="{{contacturl}}" class="tp-services-btn tp-services-btn--primary">{{contactlabel}}</a>
          <a href="{{exploreurl}}" class="tp-services-btn tp-services-btn--ghost">{{explorelabel}}</a>
        </div>
        <div class="tp-services-statrow">
          <div class="tp-services-statcard"><strong>{{servicecountvalue}}</strong><span>{{servicecountlabel}}</span></div>
          <div class="tp-services-statcard"><strong>{{coveragevalue}}</strong><span>{{coveragelabel}}</span></div>
          <div class="tp-services-statcard"><strong>{{mentoringvalue}}</strong><span>{{mentoringlabel}}</span></div>
        </div>
      </div>
      {{#hasfeatured}}
      <div class="tp-services-hero__feature">
        <div class="tp-services-feature-card">
          <span class="tp-services-pill tp-services-pill--soft">{{featuredbadge}}</span>
          <a href="{{featuredctaurl}}" class="tp-services-textlink">{{featuredctatext}}</a>
        </div>
      </div>
      {{/hasfeatured}}
    </div>
  </div>

  <div class="tp-services-shell">
    <section class="tp-services-benefits">
      {{#benefits}}
      <article class="tp-services-mini-card">
        <h3>{{title}}</h3>
        <p>{{description}}</p>
      </article>
      {{/benefits}}
    </section>

    <section class="tp-services-grid-section" id="tp-services-grid">
      <div class="tp-services-sectionhead">
        <span class="tp-services-pill">{{sectionlabel}}</span>
        <h2>{{sectionheading}}</h2>
        <p>{{sectionsubcopy}}</p>
      </div>
      {{#hasservices}}
      <div class="tp-services-grid">
        {{#services}}
        <article class="tp-service-card {{accentclass}}">
          <div class="tp-service-card__top">
            <div class="tp-service-card__badgewrap">
              <span class="tp-service-card__badge">{{badge}}</span>
              <span class="tp-service-card__initials">{{initials}}</span>
            </div>
          </div>
          <div class="tp-service-card__footer">
            <a href="{{detailurl}}" class="tp-services-textlink">View Details</a>
          </div>
        </article>
        {{/services}}
      </div>
      {{/hasservices}}
    </section>

    <section class="tp-services-process">
      <div class="tp-services-sectionhead">
        <span class="tp-services-pill">{{processlabel}}</span>
        <h2>{{processheading}}</h2>
      </div>
      <div class="tp-services-process__grid">
        {{#supportsteps}}
        <article class="tp-services-step">
          <span class="tp-services-step__number">{{number}}</span>
          <h3>{{title}}</h3>
          <p>{{description}}</p>
        </article>
        {{/supportsteps}}
      </div>
    </section>

    <section class="tp-services-cta">
      <div>
        <span class="tp-services-pill tp-services-pill--soft">{{ctalabel}}</span>
        <h2>{{ctaheading}}</h2>
        <p>{{ctacopy}}</p>
      </div>
      <div class="tp-services-cta__actions">
        <a href="{{contacturl}}" class="tp-services-btn tp-services-btn--primary">{{contactlabel}}</a>
        {{#showadminhint}}<a href="{{manageurl}}" class="tp-services-btn tp-services-btn--ghost">{{managebuttonlabel}}</a>{{/showadminhint}}
      </div>
    </section>

    {{#showadminhint}}<p class="tp-services-adminhint">{{adminhint}}</p>{{/showadminhint}}
  </div>
</section>

<style>
.tp-services-page{--tp-navy:#101934;--tp-indigo:#4256e6;--tp-violet:#8f6af8;--tp-text:#47536b;--tp-border:rgba(66,86,230,.12);color:var(--tp-navy);background:radial-gradient(circle at top left,rgba(143,106,248,.16),transparent 30%),radial-gradient(circle at top right,rgba(0,162,255,.14),transparent 28%),linear-gradient(180deg,#fbfcff 0%,#f4f7ff 42%,#fff 100%);margin:-1rem -1.5rem 0;padding-bottom:3rem}
#page.drawers .main-inner,#page.drawers div[role="main"]{padding-left:0!important;padding-right:0!important}
.header-maxwidth,#page-header,.secondary-navigation,.tertiary-navigation,.page-context-header{display:none!important}
.tp-services-shell{max-width:1240px;margin:0 auto;padding:0 24px}
.tp-services-hero{padding:72px 0 48px;position:relative;overflow:hidden}
.tp-services-hero::before,.tp-services-hero::after{content:"";position:absolute;border-radius:999px}
.tp-services-hero::before{width:340px;height:340px;background:linear-gradient(135deg,rgba(66,86,230,.18),rgba(143,106,248,.1));top:-80px;right:-90px}
.tp-services-hero::after{width:220px;height:220px;background:linear-gradient(135deg,rgba(0,162,255,.16),rgba(66,86,230,.08));bottom:0;left:-40px}
.tp-services-hero .tp-services-shell{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:32px;align-items:center}
.tp-services-pill{display:inline-flex;align-items:center;padding:10px 18px;border-radius:999px;background:rgba(66,86,230,.11);color:var(--tp-indigo);font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.tp-services-pill--soft{background:rgba(255,255,255,.16)}
.tp-services-hero h1{max-width:720px;font-size:clamp(2.5rem,4.8vw,4.6rem);line-height:1.02;letter-spacing:-.04em;margin:18px 0;font-weight:800}
.tp-services-lead,.tp-services-sectionhead p,.tp-services-step p,.tp-services-cta p,.tp-services-mini-card p,.tp-services-adminhint{color:var(--tp-text);font-size:1.02rem;line-height:1.75}
.tp-services-hero__actions,.tp-services-cta__actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
.tp-services-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:16px;text-decoration:none;font-weight:700;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease,background-color .2s ease}
.tp-services-btn:hover,.tp-service-card:hover{transform:translateY(-2px)}
.tp-services-btn--primary{background:linear-gradient(135deg,var(--tp-indigo),var(--tp-violet));color:#fff;box-shadow:0 18px 30px rgba(66,86,230,.24)}
.tp-services-btn--ghost{background:rgba(255,255,255,.72);border:1px solid var(--tp-border);color:var(--tp-navy)}
.tp-services-statrow,.tp-services-benefits,.tp-services-grid,.tp-services-process__grid{display:grid;gap:18px}
.tp-services-statrow{margin-top:30px;grid-template-columns:repeat(3,minmax(0,1fr))}
.tp-services-statcard,.tp-services-mini-card,.tp-service-card,.tp-services-step,.tp-services-feature-card,.tp-services-cta{background:rgba(255,255,255,.82);border:1px solid var(--tp-border);box-shadow:0 22px 48px rgba(16,25,52,.08);backdrop-filter:blur(10px)}
.tp-services-statcard{border-radius:22px;padding:22px 20px}.tp-services-statcard strong{display:block;font-size:1.7rem;font-weight:800}.tp-services-statcard span{color:var(--tp-text);font-size:.92rem}
.tp-services-feature-card{border-radius:32px;padding:34px;position:relative;overflow:hidden}.tp-services-feature-card::after{content:"";position:absolute;inset:auto -60px -60px auto;width:180px;height:180px;border-radius:42px;background:linear-gradient(135deg,rgba(66,86,230,.18),rgba(143,106,248,.08));transform:rotate(18deg)}.tp-services-feature-card>*{position:relative;z-index:1}
.tp-services-feature-card__image{margin:-8px -8px 18px;border-radius:24px;overflow:hidden;box-shadow:0 18px 36px rgba(16,25,52,.12)}
.tp-services-feature-card__image img{display:block;width:100%;height:240px;object-fit:cover}
.tp-services-feature-card h2,.tp-services-sectionhead h2,.tp-services-cta h2{font-size:clamp(1.9rem,3vw,3rem);line-height:1.08;margin:16px 0 14px;font-weight:800}
.tp-services-textlink{display:inline-flex;align-items:center;gap:8px;margin-top:22px;color:var(--tp-indigo);font-weight:700;text-decoration:none}
.tp-services-benefits{grid-template-columns:repeat(3,minmax(0,1fr));margin:8px 0 48px}.tp-services-mini-card,.tp-services-step,.tp-service-card{border-radius:28px;padding:26px}
.tp-services-mini-card h3,.tp-services-step h3,.tp-service-card h3{font-size:1.22rem;font-weight:800;margin:0 0 10px}
.tp-services-sectionhead{max-width:760px;margin-bottom:24px}.tp-services-grid-section,.tp-services-process{margin-top:36px}.tp-services-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.tp-service-card{position:relative;overflow:hidden;transition:transform .22s ease,box-shadow .22s ease}.tp-service-card:hover{box-shadow:0 28px 58px rgba(16,25,52,.12)}
.tp-service-card__top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}.tp-service-card__badgewrap{display:flex;flex-direction:column;gap:12px}
.tp-service-card__badge{display:inline-flex;align-self:flex-start;padding:8px 14px;border-radius:999px;font-size:12px;font-weight:700;background:rgba(255,255,255,.72);border:1px solid rgba(255,255,255,.34)}
.tp-service-card__initials{display:inline-flex;width:56px;height:56px;align-items:center;justify-content:center;border-radius:18px;font-size:1.15rem;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--tp-indigo),var(--tp-violet));box-shadow:0 18px 30px rgba(66,86,230,.22)}
.tp-service-card__image img{width:96px;height:96px;object-fit:cover;border-radius:24px}
.tp-service-card__footer{margin-top:26px;display:flex;align-items:center;justify-content:flex-end;gap:16px}
.tp-service-card.is-blue{background:linear-gradient(180deg,rgba(225,239,255,.92),rgba(255,255,255,.95))}.tp-service-card.is-indigo{background:linear-gradient(180deg,rgba(232,232,255,.92),rgba(255,255,255,.95))}.tp-service-card.is-cyan{background:linear-gradient(180deg,rgba(226,247,255,.95),rgba(255,255,255,.96))}.tp-service-card.is-coral{background:linear-gradient(180deg,rgba(255,239,236,.95),rgba(255,255,255,.96))}.tp-service-card.is-violet{background:linear-gradient(180deg,rgba(243,236,255,.96),rgba(255,255,255,.96))}.tp-service-card.is-gold{background:linear-gradient(180deg,rgba(255,248,227,.96),rgba(255,255,255,.96))}
.tp-services-process__grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tp-services-step__number{display:inline-flex;margin-bottom:16px;color:var(--tp-indigo);font-size:.92rem;font-weight:800;letter-spacing:.08em}
.tp-services-cta{margin-top:40px;border-radius:34px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:28px;background:linear-gradient(135deg,rgba(16,25,52,.96),rgba(66,86,230,.94) 55%,rgba(143,106,248,.92));color:#fff}
.tp-services-cta .tp-services-pill,.tp-services-cta h2,.tp-services-cta p,.tp-services-cta a{color:#fff}.tp-services-cta .tp-services-pill{background:rgba(255,255,255,.12)}.tp-services-cta .tp-services-btn--ghost{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.22);color:#fff}
.tp-services-adminhint{margin-top:18px;text-align:center}
@media (max-width:1100px){.tp-services-hero .tp-services-shell,.tp-services-grid,.tp-services-benefits,.tp-services-process__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:767px){.tp-services-page{margin:-1rem -.75rem 0}.tp-services-shell{padding:0 16px}.tp-services-hero{padding-top:46px}.tp-services-hero .tp-services-shell,.tp-services-grid,.tp-services-benefits,.tp-services-process__grid,.tp-services-statrow{grid-template-columns:1fr}.tp-services-feature-card,.tp-service-card,.tp-services-mini-card,.tp-services-step,.tp-services-cta{border-radius:24px}.tp-services-cta,.tp-service-card__footer{flex-direction:column;align-items:flex-start}}
</style>
