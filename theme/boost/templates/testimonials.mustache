<div class="testimonial-page-premium">
  <section class="tp-hero">
    <div class="tp-hero__backdrop"></div>

    <div class="tp-hero__main">
      <div class="tp-copy">
        <span class="tp-kicker">Learner Stories</span>
        <h1>Proof that premium learning can feel personal, practical, and career-changing.</h1>
        <p>
          Explore the journeys of eLearnKranti learners who turned guidance,
          mentorship, and hands-on training into real confidence and real outcomes.
        </p>

        <div class="tp-statbar">
          <div class="tp-stat">
            <strong>{{totalstories}}</strong>
            <span>Featured stories</span>
          </div>
          <div class="tp-stat">
            <strong>{{averagerating}}</strong>
            <span>Average rating</span>
          </div>
          <div class="tp-stat">
            <strong>{{learnersreached}}</strong>
            <span>Learners impacted</span>
          </div>
        </div>

        <div class="tp-actions">
          <a class="tp-btn tp-btn--primary" href="{{config.wwwroot}}/course/index.php">Explore Courses</a>
          <a class="tp-btn tp-btn--ghost" href="{{config.wwwroot}}/theme/boost/contact.php">Talk to Our Team</a>
        </div>
      </div>

      <article class="tp-featured">
        <div class="tp-featured__video">
          <iframe src="{{featured.videoembed}}" title="{{featured.name}} testimonial" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div class="tp-featured__body">
          <div class="tp-chip">{{featured.highlight}}</div>
          <div class="tp-stars">{{{featured.stars}}}</div>
          <p>{{featured.message}}</p>
          <div class="tp-person">
            <div class="tp-avatar">{{featured.initials}}</div>
            <div>
              <div class="tp-name">{{featured.name}}</div>
              <div class="tp-role">{{featured.role}}</div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="tp-marquee" aria-hidden="true">
      <span>Career Growth</span>
      <span>Hands-on Learning</span>
      <span>Premium Mentorship</span>
      <span>Interview Readiness</span>
      <span>Real Outcomes</span>
      <span>Career Growth</span>
      <span>Hands-on Learning</span>
      <span>Premium Mentorship</span>
      <span>Interview Readiness</span>
      <span>Real Outcomes</span>
    </div>
  </section>

  <section class="tp-grid-section">
    <div class="tp-sectionhead">
      <div>
        <span class="tp-kicker tp-kicker--light">Testimonials</span>
        <h2>Voices from learners who transformed their direction with eLearnKranti</h2>
      </div>
      <p>
        A premium learning platform should create more than course completions.
        It should create clarity, confidence, and career momentum.
      </p>
    </div>

    <div class="tp-grid">
      {{#testimonials}}
      <article class="tp-card">
        <div class="tp-card__media">
          <iframe src="{{videoembed}}" title="{{name}} testimonial" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div class="tp-card__body">
          <div class="tp-card__meta">
            <span class="tp-chip tp-chip--soft">{{highlight}}</span>
            <div class="tp-stars tp-stars--small">{{{stars}}}</div>
          </div>
          <p>{{message}}</p>
          <div class="tp-person">
            <div class="tp-avatar">{{initials}}</div>
            <div>
              <div class="tp-name">{{name}}</div>
              <div class="tp-role tp-role--dark">{{role}}</div>
            </div>
          </div>
        </div>
      </article>
      {{/testimonials}}
    </div>
  </section>
</div>

