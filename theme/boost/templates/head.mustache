{{!
    Page header.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<style>
    @media only screen and (max-width: 600px) {
 .category-browse .coursebox {
    width: 93%;
 }
 .footer-content-popover{
     display: none;
 }
     .SearchSection input {
        min-width: 55% !important;
        max-width: 55% !important;
    }
    .SearchSection button {
        width: 40%;
    }
}

/* Keep Moodle tertiary navigation dropdowns usable on Participants pages. */
.path-user .tertiary-navigation,
.path-user .tertiary-navigation .navitem,
.path-user .tertiary-navigation .tertiary-navigation-selector,
.path-user .tertiary-navigation .dropdown.select-menu {
    overflow: visible;
}

.path-user .tertiary-navigation .dropdown.select-menu {
    position: relative;
}

.path-user .tertiary-navigation .dropdown-menu[role="listbox"] {
    min-width: 18rem;
    max-width: min(90vw, 28rem);
    max-height: min(70vh, 28rem);
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 1060;
}

.path-user .tertiary-navigation .dropdown-menu[role="listbox"] .dropdown-item,
.path-user .tertiary-navigation .dropdown-menu[role="listbox"] [role="presentation"] {
    white-space: normal;
}

/* Keep RemUI "Add content" dropdowns visible and above section cards. */
body#page-course-view-remuiformat .course-content .divider,
body#page-course-view-remuiformat .course-content .divider .divider-content,
body#page-course-view-remuiformat .course-content .divider .dropdown {
    overflow: visible;
}

body#page-course-view-remuiformat .course-content .divider .divider-content {
    z-index: 1055;
}

body#page-course-view-remuiformat .course-content .divider .dropdown-menu {
    z-index: 1060;
    min-width: 15rem;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.pathname.match(/\/course\/index\.php$/)) {
        return;
    }

    document.querySelectorAll('.coursebox a[href*="/course/view.php?id="]').forEach(function(link) {
        try {
            var url = new URL(link.href, window.location.origin);
            var courseId = url.searchParams.get('id');
            if (!courseId) {
                return;
            }
            link.href = window.location.origin + '/enrol/index.php?id=' + courseId;
        } catch (e) {
            // Ignore malformed links and leave Moodle defaults intact.
        }
    });
});
</script>
