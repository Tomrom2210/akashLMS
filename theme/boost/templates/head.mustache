{{!
    Page header.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<style>
    @media only screen and (max-width: 600px) {
 .category-browse .coursebox {
    width: 93%;
 }
 .footer-content-popover{
     display: none;
 }
     .SearchSection input {
        min-width: 55% !important;
        max-width: 55% !important;
    }
    .SearchSection button {
        width: 40%;
    }
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.pathname.match(/\/course\/index\.php$/)) {
        return;
    }

    document.querySelectorAll('.coursebox a[href*="/course/view.php?id="]').forEach(function(link) {
        try {
            var url = new URL(link.href, window.location.origin);
            var courseId = url.searchParams.get('id');
            if (!courseId) {
                return;
            }
            link.href = window.location.origin + '/enrol/index.php?id=' + courseId;
        } catch (e) {
            // Ignore malformed links and leave Moodle defaults intact.
        }
    });
});
</script>
