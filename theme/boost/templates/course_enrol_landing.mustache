<!-- HERO SECTION -->
<div class="udemy-hero">
  <div class="hero-inner">

    <!-- LEFT -->
    <div class="hero-left">
      <h1>{{fullname}}</h1>

      {{#teachers.0}}
      <p class="instructor">Created by <b>{{name}}</b></p>
      {{/teachers.0}}

      <div class="meta">
        ⭐ 4.5 (2,134 ratings) • 12,450 students
      </div>

      <div class="breadcrumb">
        <a href="{{ config.wwwroot }}/theme/boost/home1.php">Dashboard</a> › 
        <a href="{{ config.wwwroot }}/course/index.php?categoryid=1">Courses</a>
      </div>
    </div>

    <!-- RIGHT CARD -->
    <div class="hero-card">
      {{#courseimage}}
      <img src="{{courseimage}}" alt="{{fullname}}">
      {{/courseimage}}

      <a class="buy-btn" href="{{ config.wwwroot }}/login/index.php">Enroll Now</a>
    </div>

  </div>
</div>


<!-- 🔥 PREMIUM ENROLL SECTION -->
<div class="enroll-section">
  <div class="enroll-container">

    <!-- LEFT -->
    <div class="enroll-left">
      <h2>Start learning today 🚀</h2>
      <p>Join thousands of students and upgrade your skills.</p>
    </div>

    <!-- RIGHT (MOODLE WIDGET FIXED) -->
    <div class="enroll-right">
      <div class="enroll-box">
        {{#enrolwidgets}}
        {{{.}}}
        {{/enrolwidgets}}
      </div>
    </div>

  </div>
</div>


<!-- MAIN CONTENT -->
<div class="udemy-container">

  <!-- LEFT -->
  <div class="udemy-left">

    {{#summary}}
    <div class="box">
      <h2>Course Description</h2>
      <div class="content">{{{summary}}}</div>
    </div>
    {{/summary}}

    <div class="box">
      <h2>What you'll learn</h2>
      <ul class="learn-list">
        <li>✔ Build real-world projects</li>
        <li>✔ Master core concepts</li>
        <li>✔ Become job-ready</li>
        <li>✔ Hands-on exercises</li>
      </ul>
    </div>

  </div>

  <!-- SIDEBAR -->
  <div class="udemy-sidebar">

    <div class="sidebar-card">
      <h3>This course includes:</h3>
      <ul>
        <li>📺 10 hours on-demand video</li>
        <li>📄 Articles & resources</li>
        <li>📱 Access on mobile & TV</li>
        <li>🏆 Certificate of completion</li>
      </ul>
    </div>

    <div class="sidebar-card">
      <h3>Course Details</h3>
      <div class="detail"><span>Level</span><b>Intermediate</b></div>
      <div class="detail"><span>Language</span><b>English</b></div>
      <div class="detail"><span>Duration</span><b>4 Weeks</b></div>
    </div>

  </div>

</div>


