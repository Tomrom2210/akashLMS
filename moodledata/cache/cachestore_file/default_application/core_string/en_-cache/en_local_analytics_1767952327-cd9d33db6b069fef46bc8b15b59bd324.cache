a:29:{s:10:"pluginname";s:9:"Analytics";s:9:"analytics";s:9:"Analytics";s:13:"analyticsdesc";s:47:"Choose the type of Analytics you want to insert";s:11:"analyticsid";s:19:"Google Analytics id";s:16:"analyticsid_desc";s:26:"For example: UA-12345678-1";s:6:"siteid";s:7:"Site ID";s:11:"siteid_desc";s:24:"Enter your Piwik Site ID";s:7:"siteurl";s:13:"Analytics URL";s:12:"siteurl_desc";s:112:"Enter your Piwik Analytics URL without http(s) or a trailing slash (for both Google Analytics types leave empty)";s:7:"enabled";s:7:"Enabled";s:12:"enabled_desc";s:27:"Enable Analytics for Moodle";s:10:"imagetrack";s:14:"Image Tracking";s:8:"cleanurl";s:10:"Clean URLs";s:13:"cleanurl_desc";s:43:"Generate clean URL for in advanced tracking";s:15:"imagetrack_desc";s:87:"Enable Image Tracking for Moodle for browsers with JavaScript disabled (only for Piwik)";s:10:"trackadmin";s:15:"Tracking Admins";s:15:"trackadmin_desc";s:48:"Enable tracking of Admin users (not recommended)";s:4:"view";s:4:"View";s:4:"edit";s:4:"Edit";s:5:"piwik";s:5:"Piwik";s:9:"piwikdesc";s:69:"Use Piwik analytics, make sure you enter a site id when enabling this";s:10:"guniversal";s:26:"Google Universal Analytics";s:14:"guniversaldesc";s:88:"Google Universal Analytics, make sure you enter a google analytics id when enabling this";s:11:"anonymizeip";s:13:"Anonymize IPs";s:16:"anonymizeip_desc";s:90:"Google Universal Analytics: When present, the IP address of the sender will be anonymized.";s:4:"head";s:6:"Header";s:9:"topofbody";s:11:"Top of body";s:6:"footer";s:6:"Footer";s:22:"privacy:no_data_reason";s:59:"The local analytics plugin doesn't store any personal data.";}